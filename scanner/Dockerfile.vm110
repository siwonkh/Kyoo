FROM ghcr.io/zoriya/kyoo_scanner:5.3.0@sha256:a19d38b807501793e5b4ac1c2155eff039af95cd546d0e66b9cfc4326a87240c
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/siwonkh/Kyoo" org.opencontainers.image.revision=$SOURCE_REVISION com.siwonkh.kyoo.upstream="v5.3.0"
COPY scanner /app/scanner
COPY tests /audit/tests
RUN python -m compileall -q /app/scanner

