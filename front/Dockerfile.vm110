FROM oven/bun:debian AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y nodejs && rm -f /usr/local/bun-node-fallback-bin/node
COPY package.json bun.lock ./
COPY patches patches
COPY scripts scripts
COPY public public
RUN bun install --frozen-lockfile
COPY . .
RUN bun run typecheck && bun test tests/*.mjs && bun web

FROM ghcr.io/zoriya/kyoo_front:5.3.0@sha256:8cc854d16c005fd8867e6e422f6af8e49e4ad2c271e1577a5b2b8193d837ffb4
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/siwonkh/Kyoo" org.opencontainers.image.revision=$SOURCE_REVISION com.siwonkh.kyoo.upstream="v5.3.0"
COPY --from=builder /app/dist /usr/share/nginx/html

